{
  "name": "verto",
  "version": "0.0.0",
  "description": "Controle pessoal de investimentos",
  "author": "rslemos",
  "main": "dist/verto/electron/main.js",
  "electronmon": { "patterns": ["dist/verto/electron/**"] },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build:angular": "ng build --configuration development",
    "watch:angular": "ng build --watch --configuration development",
    "build:electron": "tsc -p src/electron",
    "watch:electron": "tsc -p src/electron --watch --preserveWatchOutput",
    "start:electron": "npm run build:electron && electron dist/verto/electron/main.js",
    "dev:electron": "concurrently -n ng,tsc,app \"ng serve\" \"npm run watch:electron\" \"wait-on tcp:4200 file:dist/verto/electron/main.js && electronmon .\"",
    "package": "npm run build:angular && npm run build:electron && electron-builder",
    "install:local": "bash scripts/install.sh"
  },
  "private": true,
  "packageManager": "npm@12.2.0",
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "concurrently": "^10.0.6",
    "electron": "^44.9.0",
    "electron-builder": "^26.18.0",
    "electronmon": "^2.0.4",
    "rxjs": "~7.8.0",
    "typescript": "~6.0.2",
    "wait-on": "^9.5.1"
  }
}
